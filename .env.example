# local = demo inbox is a folder of .eml files under state/mailbox (no accounts needed)
# gmail = a real Gmail inbox over IMAP (read-only) + SMTP
MAIL_BACKEND=local

# Only for MAIL_BACKEND=gmail. Use a throwaway demo account with 2-Step Verification
# and an app password (Google Account > Security > App passwords). Never commit .env.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# In demo mode vendor emails only go to plus-aliases of the demo inbox,
# e.g. you+shreepack@gmail.com, so nothing reaches a real company.
DEMO_MODE=true
MAX_EMAILS_PER_RUN=8

HOST=127.0.0.1
PORT=8000
